{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dqmjr/mcp-audit-gateway",
  "title": "MCP Audit Gateway",
  "description": "Local MCP policy + hash-chained audit proxy for Cursor/Claude tool calls.",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/dqmjr/cursor-ai-agent-tooling-projects/tree/main/mcp-sentinel",
  "repository": {
    "url": "https://github.com/dqmjr/cursor-ai-agent-tooling-projects",
    "source": "github",
    "subfolder": "mcp-sentinel"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcp-audit-gateway",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "proxy" },
        {
          "type": "named",
          "name": "--config",
          "valueHint": "config_path",
          "description": "Path to sentinel.json",
          "isRequired": true,
          "format": "filepath"
        }
      ]
    }
  ]
}
