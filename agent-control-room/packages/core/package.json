{
  "name": "@acr/core",
  "version": "0.1.0",
  "description": "Agent Control Room daemon — event schema, Fastify/WebSocket API, SQLite store",
  "type": "module",
  "bin": {
    "acr": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts daemon",
